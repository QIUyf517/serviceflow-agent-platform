# Copy to .env.phase4 and replace every <...> placeholder. Never commit it.
POSTGRES_USER=serviceflow
POSTGRES_PASSWORD=<local-demo-database-password>
POSTGRES_DB=serviceflow_demo
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=postgresql+psycopg://serviceflow:<local-demo-database-password>@db:5432/serviceflow_demo
TEST_DATABASE_URL=postgresql+psycopg://serviceflow:<local-demo-database-password>@127.0.0.1:5432/serviceflow_demo

# Demo-only operator credential. Independent from customer sessions; not production IAM.
OPERATOR_DEMO_TOKEN=<local-demo-operator-token>
OPERATOR_DEMO_ID=operator-demo
MERCHANT_DEMO_ID=merchant-demo

CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5
CHECKPOINT_POOL_TIMEOUT_SECONDS=10
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BASE_SECONDS=0.05
EXECUTION_RETRY_MAX_SECONDS=0.5
EXECUTION_LEASE_SECONDS=30
EXECUTION_LOCK_TIMEOUT_MS=2000
EXECUTION_STATEMENT_TIMEOUT_MS=10000
APPROVAL_TTL_SECONDS=86400

# Phase 4 always runs locally and never enables an external chat provider.
AGENT_PROVIDER=mock
POLICY_RETRIEVAL_STRATEGY=keyword

# Optional external-provider placeholders are intentionally unset.
# For customer order threads, Compose enables hybrid understanding when a key is set.
# With no key, the customer chat uses the offline parser.
# CUSTOMER_TRIAGE_PROVIDER=hybrid
# LLM_API_KEY=<external-provider-api-key>
# LLM_MODEL_ID=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_API_KEY=<external-provider-api-key>
# POLICY_EMBEDDING_API_KEY=<external-embedding-api-key>
