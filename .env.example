DATABASE_URL=postgresql+psycopg://serviceflow:serviceflow_local@localhost:5432/serviceflow_demo
POSTGRES_USER=serviceflow
POSTGRES_PASSWORD=serviceflow_local
POSTGRES_DB=serviceflow_demo
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5
CHECKPOINT_POOL_TIMEOUT_SECONDS=10
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BASE_SECONDS=0.05
EXECUTION_RETRY_MAX_SECONDS=0.5
EXECUTION_LEASE_SECONDS=30
EXECUTION_LOCK_TIMEOUT_MS=2000
EXECUTION_STATEMENT_TIMEOUT_MS=10000
# Demo-only operator credential. Set a non-placeholder value in local .env.
# This is independent from customer session credentials and is not production IAM.
OPERATOR_DEMO_TOKEN=replace-with-local-operator-token
OPERATOR_DEMO_ID=operator-demo
APPROVAL_TTL_SECONDS=86400
AGENT_PROVIDER=mock
AGENT_MODEL=gpt-4.1-mini
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_TEMPERATURE=0
AGENT_SEED=42
# Set AGENT_API_KEY or OPENAI_API_KEY only in .env or process environment.
# Policy keyword retrieval is the offline default. Vector mode requires PostgreSQL pgvector.
POLICY_RETRIEVAL_STRATEGY=keyword
POLICY_TOP_K=3
POLICY_EMBEDDING_MODEL=text-embedding-3-small
POLICY_EMBEDDING_DIMENSIONS=1536
POLICY_EMBEDDING_BASE_URL=https://api.openai.com/v1
POLICY_EMBEDDING_BATCH_SIZE=32
POLICY_EMBEDDING_PROVIDER=openai_compatible
# Local real embedding alternative (no API key; first run downloads the model):
POLICY_LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
POLICY_LOCAL_EMBEDDING_DIMENSIONS=384
POLICY_LOCAL_EMBEDDING_CACHE=.cache/fastembed
# Set POLICY_EMBEDDING_API_KEY only in .env or the process environment.
# POLICY_EMBEDDING_API_KEY=
